# Copy to `.env` (gitignored) and fill in. Only needed for the LLM labeling and
# prevalence-judge stages — the embedding + clustering core runs without any key.

# OpenRouter API key (https://openrouter.ai/keys). One key covers every model
# (anthropic/*, openai/*, deepseek/*, …) since OpenRouter proxies them all.
OPENROUTER_API_KEY=sk-or-...

# Optional: point at a different OpenAI-compatible gateway (defaults to OpenRouter).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
